; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Inkodot Editor"
config/description="A cross-platform editor for Ink dialogue, built in Godot 4. Ships both as a Godot editor plugin and as a standalone desktop application — same codebase, two ways to use it."
run/main_scene="uid://e7n1blit5uca"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=0.8

[dotnet]

project/assembly_name="Ink Editor"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/ink/plugin.cfg", "res://addons/inkodot_editor/plugin.cfg")

[inkodot]

is_standalone_app=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
